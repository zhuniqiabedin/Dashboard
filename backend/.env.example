MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/career-space?appName=Cluster0
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=replace-with-a-strong-password
SEED_USER_NAME=Your Name
# Brevo > Transactional > SMTP & API > SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=Workpath <verified-sender@example.com>
APP_URL=http://localhost:4200
